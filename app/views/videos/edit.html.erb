<div><b>Edit Video</b></div>

<div><%= link_to 'Back', videos_path %></div>

<% flash.each do |key, message| %>
    <div><i><%= message %></i></div>
<% end %>

<div>
    <%= form_with model: @video, local: true, multipart: true do |form| %>
        <div>
        <%= form.label :title %>
            <%= form.text_field :title %>
        </div>
    <% end %>
</div>