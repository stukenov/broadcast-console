<div><b>Generate Events</b></div>

<div><%= link_to 'Back', channel_events_path(@channel) %></div>

<div>
    <%= form_with url: generate_channel_events_path(@channel), method: :post do |form| %>
        <div>
            <%= form.label :start_time, "Start Time" %>
            <%= form.datetime_field :start_time %>
        </div>
        <div>
            <%= form.label :end_time, "End Time" %>
            <%= form.datetime_field :end_time %>
        </div>
        <div>
            <%= form.submit "Generate" %>
        </div>
    <% end %>
</div>
