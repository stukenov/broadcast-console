<div>
    <b>Events for <%= @channel.name %> <%= link_to 'Generate Events', generate_channel_events_path(@channel) %> | <%= link_to 'New Event', new_channel_event_path(@channel) %></b>
</div>

<% flash.each do |key, message| %>
    <div>
        <b><%= message %></b>
    </div>
<% end %>

<div>
    <table cellpadding="0" cellspacing="0">
        <tbody>
            <% if @events.nil? %>
                <tr>
                    <td>No events found</td>
                </tr>
            <% else %>
                <% @events.each do |event| %>
                    <tr>
                    <td>
                        <b><%= event.start_time.strftime("%H:%M:%S") %> <%= link_to event.name, channel_event_path(@channel, event) %> <%= link_to '....', edit_channel_event_path(@channel, event) %> File: ok</b>                        
                    </td>
                    <td>
                        <%= button_to 'x', channel_event_path(@channel, event), method: :delete %>
                    </td>
                    </tr>
                <% end %>
            <% end %>
        </tbody>
    </table>
</div>
