
<%= form_with(model: command, local: true) do |form| %>
  <% if command.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(command.errors.count, "error") %> prohibited this command from being saved:</h2>
      <ul>
        <% command.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :server_id %>
    <%= form.collection_select :server_id, Server.all, :id, :name %>
  </div>

  <div class="field">
    <%= form.label :target %>
    <%= form.text_field :target %>
  </div>

  <div class="field">
    <%= form.label :length %>
    <%= form.text_field :length %>
  </div>

  <div class="field">
    <%= form.label :command %>
    <%= form.text_field :command %>
  </div>

  <div class="actions">
    <%= form.submit %>
  </div>
<% end %>
